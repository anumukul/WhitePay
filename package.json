{
  "name": "whitepay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "build": "pnpm --filter @whitepay/shared build",
    "typecheck": "pnpm --filter @whitepay/shared typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "test:integration": "node scripts/unavailable.mjs integration",
    "test:e2e": "node scripts/unavailable.mjs e2e",
    "test:sepolia": "node scripts/unavailable.mjs sepolia",
    "test:contracts": "pnpm test:checkout",
    "probe:token": "pnpm build && node scripts/probe-token.mjs",
    "test:poc": "forge test --root packages/contracts -vv",
    "test:poc:fork": "FOUNDRY_PROFILE=fork forge test --root packages/contracts --fork-url https://rpc.testnet.whitechain.io --fork-block-number 12300809 --match-contract OfficialTokenForkTest -vv",
    "build:poc": "forge build --root packages/contracts",
    "poc:preflight": "pnpm build && pnpm build:poc && node scripts/poc/preflight.mjs",
    "poc:wallet-config": "pnpm build && node scripts/poc/wallet-config.mjs",
    "poc:estimate-deployment": "pnpm build:poc && node scripts/poc/estimate-deployment.mjs",
    "poc:wallet-addresses": "pnpm build && node scripts/poc/export-wallet-addresses.mjs",
    "build:checkout": "FOUNDRY_PROFILE=step03 forge build --root packages/contracts",
    "test:checkout": "FOUNDRY_PROFILE=step03 forge test --root packages/contracts -vv",
    "test:checkout:fork": "FOUNDRY_PROFILE=step03fork forge test --root packages/contracts --fork-url https://rpc.testnet.whitechain.io --fork-block-number 12300809 --match-contract OfficialCheckoutForkTest -vv",
    "db:local": "node infra/local-postgres.mjs",
    "test:api": "pnpm --filter @whitepay/api test"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "viem": "2.38.5"
  }
}
