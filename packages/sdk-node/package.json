{
  "name": "@whitepay/node",
  "version": "0.1.0-alpha.0",
  "description": "Server-side merchant SDK for WhitePay on Whitechain Sepolia.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test --import tsx/esm test/*.test.ts",
    "test:package": "pnpm build && node --import tsx/esm test/package-smoke.ts",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@whitepay/api": "workspace:*",
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anumukul/WhitePay.git",
    "directory": "packages/sdk-node"
  },
  "homepage": "https://github.com/anumukul/WhitePay/tree/main/packages/sdk-node#readme",
  "bugs": {
    "url": "https://github.com/anumukul/WhitePay/issues"
  },
  "keywords": [
    "whitepay",
    "whitechain",
    "sepolia",
    "usdt",
    "payments",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}
