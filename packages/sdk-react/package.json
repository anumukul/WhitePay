{
  "name": "@whitepay/react",
  "version": "0.1.0-alpha.0",
  "description": "React checkout widget for WhitePay on Whitechain Sepolia.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test --import tsx/esm test/*.test.ts",
    "test:browser": "node --test --import tsx/esm test/browser.e2e.ts",
    "step09:live": "pnpm --filter @whitepay/node build && node --import tsx/esm scripts/live-checkout.ts",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@whitepay/api": "workspace:*",
    "@whitepay/chain": "workspace:*",
    "@whitepay/node": "workspace:*",
    "esbuild": "0.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "viem": "2.38.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anumukul/WhitePay.git",
    "directory": "packages/sdk-react"
  },
  "homepage": "https://github.com/anumukul/WhitePay/tree/main/packages/sdk-react#readme",
  "bugs": {
    "url": "https://github.com/anumukul/WhitePay/issues"
  },
  "keywords": [
    "whitepay",
    "whitechain",
    "sepolia",
    "usdt",
    "payments",
    "react"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}
