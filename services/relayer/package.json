{
  "name": "@whitepay/relayer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "node --import tsx/esm src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
