  "dependencies": {
    "@whitepay/chain": "workspace:*",
    "@whitepay/api": "workspace:*",
    "viem": "2.38.5"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  }
}
