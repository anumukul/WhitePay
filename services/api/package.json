{
  "name": "@whitepay/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./src/*": "./src/*"
  },
  "scripts": {
    "dev": "node --import tsx/esm src/server.ts",
    "seed": "node --import tsx/esm scripts/seed-demo-merchant.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx/esm test/*.test.ts",
    "migrate": "node --import tsx/esm scripts/migrate.mjs"
  },
  "dependencies": {
    "pg": "8.16.3",
    "viem": "2.38.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/pg": "8.15.5",
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  }
}
