{
  "name": "@whitepay/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node --input-type=module -e \"import {rmSync} from 'node:fs'; rmSync('out',{recursive:true,force:true});\"",
    "dev": "next dev -p 3500",
    "build": "next build",
    "start": "next start -p 3500",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node --test test/browser.e2e.mjs",
    "export:pitch": "node scripts/export-pitch.mjs"
  },
  "dependencies": {
    "next": "15.5.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.9.3"
  }
}
